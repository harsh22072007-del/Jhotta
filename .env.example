# Copy to .env after deploying the backend (values come from the CloudFormation outputs).
# These are public identifiers, not secrets. The Google client secret lives only in Cognito.
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_COGNITO_DOMAIN=https://jhotta-yourname.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
